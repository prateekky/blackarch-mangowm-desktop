#!/usr/bin/python
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
PROFILE_DIR = HOME / ".config/nwg-displays/profiles"
MONITORS_FILE = HOME / ".config/mango/monitors.conf"
ACTIVE_FILE = HOME / ".config/nwg-displays/active_profile.json"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))


def compositor_env():
    env = os.environ.copy()
    candidates = sorted(RUNTIME.glob("mango-*.sock"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not candidates:
        raise RuntimeError("Mango IPC socket not found; is MangoWM running?")
    env["MANGO_INSTANCE_SIGNATURE"] = str(candidates[0])
    return env


def mmsg(env, *args):
    result = subprocess.run(["mmsg", *args], env=env, text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "mmsg failed")
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return result.stdout.strip()
    if isinstance(data, dict) and data.get("success") is False:
        raise RuntimeError(data.get("error", "Mango rejected the command"))
    return data


def current_outputs():
    result = subprocess.run(["wlr-randr"], text=True, capture_output=True, check=True)
    outputs = {}
    name = None
    for line in result.stdout.splitlines():
        if line and not line[0].isspace():
            match = re.match(r'(\S+) "', line)
            if match:
                name = match.group(1)
                outputs[name] = False
        elif name and line.strip().startswith("Enabled:"):
            outputs[name] = line.strip().endswith("yes")
    return outputs


def monitor_rule(display):
    name = re.escape(display["name"])
    width = int(display["physical_width"])
    height = int(display["physical_height"])
    refresh = float(display["refresh"])
    x, y = int(display["x"]), int(display["y"])
    scale = float(display["scale"])
    parts = [f"name:^{name}$", f"width:{width}", f"height:{height}",
             f"refresh:{refresh:g}", f"x:{x}", f"y:{y}", f"scale:{scale:g}"]
    transform = {"normal": 0, "90": 1, "180": 2, "270": 3,
                 "flipped": 4, "flipped-90": 5, "flipped-180": 6,
                 "flipped-270": 7}.get(display.get("transform", "normal"), 0)
    if transform:
        parts.append(f"rr:{transform}")
    parts.append("vrr:1" if display.get("adaptive_sync") else "vrr:0")
    if display.get("primary"):
        parts.append("primary:1")
    return "monitor_rule=" + ",".join(parts)


def apply(name):
    profile_path = PROFILE_DIR / f"{name}.json"
    if not profile_path.is_file():
        raise RuntimeError(f"Profile not found: {name}")
    profile = json.loads(profile_path.read_text())
    displays = profile.get("displays", [])
    desired = {d["name"]: d for d in displays if d.get("active", False)}
    if not desired:
        raise RuntimeError("Refusing a profile with no active displays")

    env = compositor_env()
    live = current_outputs()
    unknown = set(desired) - set(live)
    if unknown:
        raise RuntimeError("Profile needs disconnected output(s): " + ", ".join(sorted(unknown)))

    # Ensure a desired output is live before changing rules or disabling anything.
    for output in desired:
        if not live.get(output, False):
            mmsg(env, "dispatch", f"enable_monitor,{output}")

    MONITORS_FILE.parent.mkdir(parents=True, exist_ok=True)
    if MONITORS_FILE.exists():
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        backup = MONITORS_FILE.with_name(MONITORS_FILE.name + ".bak-" + stamp)
        backup.write_bytes(MONITORS_FILE.read_bytes())

    text = "# Generated by Mango Display Profile launcher: " + name + "\n"
    text += "\n".join(monitor_rule(d) for d in desired.values()) + "\n"
    with tempfile.NamedTemporaryFile("w", dir=MONITORS_FILE.parent, delete=False) as f:
        f.write(text)
        temp_path = Path(f.name)
    temp_path.replace(MONITORS_FILE)
    mmsg(env, "dispatch", "reload_config")

    for d in displays:
        output = d["name"]
        if output not in live:
            continue
        if d.get("active", False):
            action = "wakeup_monitor" if d.get("dpms", True) else "sleep_monitor"
        else:
            action = "disable_monitor"
        mmsg(env, "dispatch", f"{action},{output}")

    ACTIVE_FILE.parent.mkdir(parents=True, exist_ok=True)
    ACTIVE_FILE.write_text(json.dumps({"active_profile": name}, indent=2) + "\n")
    print(f"Applied display profile: {name}")


def main():
    try:
        if len(sys.argv) > 1 and sys.argv[1] != "--select":
            apply(" ".join(sys.argv[1:]))
            return
        profiles = sorted(p.stem for p in PROFILE_DIR.glob("*.json"))
        if not profiles:
            raise RuntimeError("No saved NWG display profiles found")
        chooser = subprocess.run(["noctalia", "dmenu", "--prompt", "Display profile"],
                                 input="\n".join(profiles) + "\n", text=True, capture_output=True)
        if chooser.returncode or not chooser.stdout.strip():
            return
        apply(chooser.stdout.strip())
    except Exception as e:
        print(f"Display profile error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
